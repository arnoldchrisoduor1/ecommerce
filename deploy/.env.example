# Ecommerce env — used locally AND copied to deploy/.env for production.
# Never commit real secrets. Deploy script: copy root .env → server.

# --- Domains / public URLs (production) ---
FRONTEND_DOMAIN=ecommerce.oduor-arnold.com
API_DOMAIN=ecomm-api.oduor-arnold.com

# --- Host ports on VPS (loopback; avoid wellness/landing clash) ---
FRONTEND_HOST_PORT=3082
BACKEND_HOST_PORT=8082
MINIO_HOST_PORT=9002

# --- Postgres ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-strong-db-password

# Backend DB URL (compose network uses host "postgres"; local host uses localhost)
DATABASE_URL=postgres://ecommerce:change-me-strong-db-password@postgres:5432/ecommerce
REDIS_ADDR=redis:6379
CORS_ALLOW_ORIGINS=https://ecommerce.oduor-arnold.com
PORT=8080

# --- Admin auth ---
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change-me-in-production
ADMIN_PASSWORD=change-me-in-production
ADMIN_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PRESENCE_TTL_SECONDS=60

# --- M-Pesa (optional) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://ecomm-api.oduor-arnold.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# --- AI stylist (OpenRouter; optional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_STYLIST_MOCK_MODE=false
OPENROUTER_TRYON_MODEL=bytedance-seed/seedream-4.5
AI_TRYON_MOCK_MODE=false
OPENROUTER_TRYON_MODEL=bytedance-seed/seedream-4.5
AI_TRYON_MOCK_MODE=false

# --- MinIO daemon (compose service) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_HOST_PORT=9002
MINIO_BUCKET=ecommerce

# --- Object storage (API SDK + public URLs) ---
S3_INTERNAL_ENDPOINT=minio:9000
S3_PUBLIC_BASE_URL=https://ecomm-api.oduor-arnold.com/media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-strong-minio-password
MINIO_USE_SSL=false

# --- App mode (demo|production; default production if unset/invalid) ---
# Demo site: set BOTH to demo AND rebuild the frontend image —
# NEXT_PUBLIC_APP_MODE is baked at build time (mascot/tree-shake).
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
DEMO_CONTACT_EMAIL=arnoldchrisoduor@gmail.com
DEMO_CONTACT_PHONE=+254791165995

# --- OpenRouter management (Task 38 AI Usage admin) ---
# Separate key type from OPENROUTER_API_KEY — generate in OpenRouter dashboard.
OPENROUTER_MANAGEMENT_KEY=
AI_LOW_BALANCE_THRESHOLD=1.0
AI_FEATURES_GLOBALLY_ENABLED=true

# --- Frontend container ---
API_URL=http://backend:8080
NODE_ENV=production
HOSTNAME=0.0.0.0
