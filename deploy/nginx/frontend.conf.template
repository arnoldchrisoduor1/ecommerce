# ${FRONTEND_DOMAIN} → Next.js (127.0.0.1:${FRONTEND_HOST_PORT})
# Placeholders replaced by deploy-server.sh from deploy/.env before install.
# Certbot will add listen 443 / ssl_* lines on first issuance.

server {
    listen 80;
    server_name __FRONTEND_DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:__FRONTEND_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
