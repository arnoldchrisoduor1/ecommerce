# ${API_DOMAIN} → Go API + MinIO media
# Placeholders replaced by deploy-server.sh from deploy/.env before install.

server {
    listen 80;
    server_name __API_DOMAIN__;

    client_max_body_size 15m;

    location /media/ {
        proxy_pass http://127.0.0.1:__MINIO_HOST_PORT__/__MINIO_BUCKET__/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:__BACKEND_HOST_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
