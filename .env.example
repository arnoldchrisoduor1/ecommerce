# Env vars read by backend/cmd/api/main.go.
# For docker-compose, these are already set in docker-compose.yml (pointing
# at the postgres/redis service names) — this file is for running the
# backend binary directly on the host.

# Required (main.go calls mustEnv() — process exits if missing)
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
REDIS_ADDR=localhost:6379

# Optional (main.go falls back to a default / empty value if unset)
CORS_ALLOW_ORIGINS=http://localhost:3000
PORT=8080

# M-Pesa Daraja (required for STK push — get from developer.safaricom.co.ke sandbox app)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-url/api/payments/mpesa/callback
MPESA_ENV=sandbox

# Admin auth (JWT — no admin_users table in V1 schema)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Presence (Redis viewer count TTL in seconds)
PRESENCE_TTL_SECONDS=60

# AI stylist (optional — StylistChat returns 503 if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
